{
	"$schema": "./node_modules/@premium-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "premium-cms-agent",
	"publisher": "plugins.premium-cms.com",
	"license": "MIT",
	"author": { "name": "PremiumCMS" },
	"security": {
		"url": "https://github.com/MahmoodKhalil57/plugin-premium-cms-agent/security/advisories/new",
	},
	"description": "Chat with a site assistant from the EmDash toolbar. It sees the page you are on through your own browser and edits content through your own access — only from the toolbar, never from an API token or MCP.",
	"keywords": ["premiumcms", "agent", "assistant", "toolbar", "ai"],

	// The assistant is the instance's own agent (agents:run); it acts through
	// the site's MCP endpoint with a short-lived token minted by the signed-in
	// editor's browser, and through that browser.
	// users:read lists the site's roles for the skills page and tells the
	// plugin which role the chatting editor holds.
	"capabilities": ["network:request", "users:read", "agents:run"],
	"allowedHosts": ["*.workers.dev", "*.premium-cms.com"],
	"storage": {
		"sessions": { "indexes": ["userId", "status", "updatedAt"] },
		"skills": { "indexes": ["enabled", "updatedAt"] },
	},

	"admin": {
		"settingsSchema": {
			"enabled": { "type": "boolean", "label": "Offer the assistant in the toolbar", "default": true },
			"model": {
				"type": "string",
				"label": "Model",
				"description": "Workers AI model id, or a provider/model slug routed through AI Gateway.",
				"default": "@cf/zai-org/glm-5.3-flash"
			},
			"reasoning": {
				"type": "select",
				"label": "Reasoning effort",
				"options": [
					{ "value": "high", "label": "High (slow, thorough)" },
					{ "value": "medium", "label": "Medium" },
					{ "value": "low", "label": "Low" }
				],
				"default": "medium"
			},
			"sessionHours": {
				"type": "number",
				"label": "Session length (hours)",
				"description": "How long a chat session — and the editor token minted for it — lives.",
				"default": 8,
				"min": 1,
				"max": 24
			}
		},
		"pages": [
			{ "path": "/agent", "label": "Site Agent", "icon": "message-circle" },
			{ "path": "/skills", "label": "Agent skills", "icon": "book-open" },
		],
	},
}
