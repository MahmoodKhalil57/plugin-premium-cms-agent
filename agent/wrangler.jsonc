{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "premium-cms-agent",
	"main": "src/server.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"ai": { "binding": "AI" },
	// toolbar.js (the chat panel + browser bridge client) is a static asset;
	// everything else is routed by the Worker.
	"assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
	"durable_objects": {
		"bindings": [
			{ "class_name": "SiteAgent", "name": "SiteAgent" },
			{ "class_name": "BrowserBridge", "name": "BrowserBridge" }
		]
	},
	"migrations": [{ "new_sqlite_classes": ["SiteAgent", "BrowserBridge"], "tag": "v1" }],
	"observability": { "enabled": true }
}
